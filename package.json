{
  "name": "score-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.0",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --cwd apps/daemon start",
    "dev": "bun run --cwd apps/daemon dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "biome check . && turbo run typecheck",
    "check:fix": "biome check --write . && turbo run typecheck",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "latest",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
